{
  "name": "face-mask-web",
  "version": "1.0.0",
  "description": "Web UI for face mask detection (Project 3 monorepo).",
  "main": "src/server/index.js",
  "scripts": {
    "heroku-prebuild": "npm install --include=dev",
    "build": "node_modules/.bin/vite build",
    "start": "npm run build && node src/server/index.js",
    "client": "node_modules/.bin/vite",
    "server": "node_modules/.bin/nodemon src/server/index.js",
    "dev": "node_modules/.bin/concurrently \"npm run server\" \"npm run client\""
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.6",
    "@mui/material": "^5.15.6",
    "@tensorflow/tfjs": "1.7.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "face-api.js": "^0.22.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-webcam": "^7.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.3",
    "vite": "^5.1.0"
  },
  "overrides": {
    "@tensorflow/tfjs-core": "1.7.0"
  }
}
